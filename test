<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Blackjack Card Counter</title>
  <link rel="stylesheet" href="styles.css"/>
</head>
<body>
  <h1>Blackjack Card Counter</h1>
  <div class="cards">
    <h2>Select a Card</h2>
    <div id="card-deck"></div>
  </div>

  <div class="hands">
    <div>
      <h2>Dealer's Hand</h2>
      <div id="dealer-hand" class="hand"></div>
    </div>
    <div>
      <h2>Player's Hand</h2>
      <div id="player-hand" class="hand"></div>
    </div>
  </div>

  <div id="counter">
    <p>Running Count: <span id="count">0</span></p>
  </div>

  <div class="buttons">
    <button onclick="resetHand()">Reset Hand</button>
    <button onclick="resetShoe()">Reset Shoe</button>
  </div>

  <script src="script.js"></script>
</body>
</html>
body {
  font-family: 'Segoe UI', sans-serif;
  text-align: center;
  background-color: #0a0a0a;
  color: #f0f0f0;
}

.cards, .hands {
  margin: 20px auto;
  max-width: 800px;
}

.hand, #card-deck {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin: 10px 0;
}

.card {
  border: 1px solid #fff;
  padding: 10px 15px;
  cursor: pointer;
  background-color: #2e2e2e;
  border-radius: 6px;
}

.card:hover {
  background-color: #444;
}

#counter {
  font-size: 24px;
  margin: 20px;
}

button {
  margin: 10px;
  padding: 10px 15px;
  font-size: 16px;
  border: none;
  border-radius: 5px;
  background-color: #3a3aff;
  color: white;
  cursor: pointer;
}

button:hover {
  background-color: #2a2ad1;
}
const cardValues = {
  'A': -1, '2': -1, '3': -1, '4': -1, '5': -1, '6': -1, '7': -1,
  '8': 0, '9': 0,
  '10': +1, 'J': +1, 'Q': +1, 'K': +1
};

let runningCount = 0;

function createCardButtons() {
  const values = Object.keys(cardValues);
  const cardDeck = document.getElementById('card-deck');
  values.forEach(value => {
    const btn = document.createElement('div');
    btn.textContent = value;
    btn.className = 'card';
    btn.addEventListener('click', () => assignCard(value));
    cardDeck.appendChild(btn);
  });
}

function assignCard(value) {
  const targetHand = prompt("Assign to: 'dealer' or 'player'?").toLowerCase();
  const handContainer = document.getElementById(`${targetHand}-hand`);
  if (!handContainer) return alert("Please choose 'dealer' or 'player'.");

  const card = document.createElement('div');
  card.className = 'card';
  card.textContent = value;
  handContainer.appendChild(card);

  runningCount += cardValues[value];
  updateCountDisplay();
}

function updateCountDisplay() {
  document.getElementById('count').textContent = runningCount;
}

function resetHand() {
  document.getElementById('dealer-hand').innerHTML = '';
  document.getElementById('player-hand').innerHTML = '';
}

function resetShoe() {
  resetHand();
  runningCount = 0;
  updateCountDisplay();
}

createCardButtons();
